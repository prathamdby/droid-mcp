{
  "name": "droid-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Factory Droid, written in Effect and served over Streamable HTTP",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/products/private/cli.ts serve",
    "doctor": "node --experimental-strip-types src/products/private/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:proofs": "vitest run --project proofs",
    "test:lint-rules": "node --experimental-strip-types scripts/test-lint-rules.ts",
    "check:boundaries": "node --experimental-strip-types scripts/check-boundaries.ts",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error",
    "fmt:check": "oxfmt --check .",
    "fmt": "oxfmt --write .",
    "codegen": "node --experimental-strip-types scripts/extract-dialect.ts",
    "codegen:check": "node --experimental-strip-types scripts/extract-dialect.ts --check"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@factory/droid-sdk": "0.10.0",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@types/node": "^24.19.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
